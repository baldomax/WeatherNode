# This template is configured for a PRODUCTION deployment (HTTPS, hardened).
# For LOCAL development, set:
#   APP_ENV=local, APP_DEBUG=true, APP_URL=http://localhost,
#   LOG_LEVEL=debug, SESSION_SECURE_COOKIE=false
# (a secure cookie is never sent over plain http://, so login would appear to fail).
# After copying, run `php artisan key:generate` to fill APP_KEY.

APP_NAME=WeatherNode
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://weathernode.example.com

# Optional automation only. For normal setup, run `php artisan admin:create`
# after migrations/seeding and keep admin passwords out of `.env`.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-this-password

# Match station timezone (e.g. Europe/Amsterdam) on production so scheduled
# polling runs on the hour in local time. Omit to use server default (often UTC).
# APP_TIMEZONE=Europe/Amsterdam

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Session cookie is only sent over HTTPS (production). Set to false for local http:// dev.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VISITORLOG_ENABLED=true
VISITORLOG_RETENTION_DAYS=90
VISITORLOG_AGGREGATE_RETENTION_DAYS=
VISITORLOG_STORE_SEARCH_TERMS=true
VISITORLOG_GEOIP_ENABLED=true
VISITORLOG_IP_HASH_SALT=
MAXMIND_LICENSE_KEY=

# Hybrid server-rendered dashboard first paint (feature flag fallback)
DASHBOARD_HYBRID_SSR=false
